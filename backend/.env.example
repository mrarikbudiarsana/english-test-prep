PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/ielts_platform

# Firebase Admin SDK (for authentication only)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Cloudinary (for file storage - audio recordings & images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Midtrans (optional — leave as-is to disable payment features)
MIDTRANS_SERVER_KEY=your_server_key
MIDTRANS_CLIENT_KEY=your_client_key
MIDTRANS_IS_PRODUCTION=false

# CORS (comma-separated allowed frontend origins; put primary app URL first)
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Feature flags
ENABLE_TOEFL_IBT_2026=false
