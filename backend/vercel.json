{
    "version": 2,
    "functions": {
        "src/app.ts": {
            "maxDuration": 60
        }
    },
    "builds": [
        {
            "src": "src/app.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/app.ts"
        }
    ]
}
